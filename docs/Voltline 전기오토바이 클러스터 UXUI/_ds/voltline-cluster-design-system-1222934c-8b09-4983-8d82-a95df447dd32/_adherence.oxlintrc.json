{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cluster/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/cluster/**",
              "ui_kits/companion-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Semi Condensed|Archivo|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow Semi Condensed, Archivo, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|detail|code|action|key|ref|className|style|children)$/]",
        "message": "<AlertBanner> doesn't accept that prop. Declared props: tone, title, detail, code, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|caution|critical)$/]",
        "message": "<AlertBanner> tone must be one of 'info' | 'caution' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|thickness|tone|label|key|ref|className|style|children)$/]",
        "message": "<ArcGauge> doesn't accept that prop. Declared props: value, max, size, thickness, tone, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcGauge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|go|caution|critical)$/]",
        "message": "<ArcGauge> tone must be one of 'accent' | 'go' | 'caution' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|go|caution|critical)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'go' | 'caution' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|rangeKm|unit|charging|segments|orientation|key|ref|className|style|children)$/]",
        "message": "<BatteryGauge> doesn't accept that prop. Declared props: percent, rangeKm, unit, charging, segments, orientation."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryGauge'] > JSXAttribute[name.name='unit'] > Literal[value!=/^(?:km|mi)$/]",
        "message": "<BatteryGauge> unit must be one of 'km' | 'mi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryGauge'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<BatteryGauge> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|icon|iconRight|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: tone, size, icon, iconRight, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|ghost|critical)$/]",
        "message": "<Button> tone must be one of 'primary' | 'secondary' | 'ghost' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|actions|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, actions, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeAccent|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeAccent."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|tone|active|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, tone, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:secondary|ghost)$/]",
        "message": "<IconButton> tone must be one of 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|tone|density|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, meta, tone, density."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Panel> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:comfortable|compact)$/]",
        "message": "<Panel> density must be one of 'comfortable' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PowerFlowBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:watts|maxDraw|maxRegen|key|ref|className|style|children)$/]",
        "message": "<PowerFlowBar> doesn't accept that prop. Declared props: watts, maxDraw, maxRegen."
      },
      {
        "selector": "JSXOpeningElement[name.name='RideMode'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<RideMode> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|label|unit|disabled|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange, label, unit, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeedReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|size|limit|key|ref|className|style|children)$/]",
        "message": "<SpeedReadout> doesn't accept that prop. Declared props: value, unit, size, limit."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeedReadout'] > JSXAttribute[name.name='unit'] > Literal[value!=/^(?:km\\/h|mph)$/]",
        "message": "<SpeedReadout> unit must be one of 'km/h' | 'mph'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeedReadout'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<SpeedReadout> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|description|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, description, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Telltale'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|active|blink|size|label|key|ref|className|style|children)$/]",
        "message": "<Telltale> doesn't accept that prop. Declared props: icon, tone, active, blink, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Telltale'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:turn|beam|go|caution|critical|info)$/]",
        "message": "<Telltale> tone must be one of 'turn' | 'beam' | 'go' | 'caution' | 'critical' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TelltaleRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|align|size|key|ref|className|style|children)$/]",
        "message": "<TelltaleRail> doesn't accept that prop. Declared props: items, align, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TelltaleRail'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<TelltaleRail> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|mono|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, invalid, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: icon, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|go|caution)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'go' | 'caution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|icon|size|tone|key|ref|className|style|children)$/]",
        "message": "<TripStat> doesn't accept that prop. Declared props: label, value, unit, icon, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripStat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TripStat> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripStat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<TripStat> tone must be one of 'default' | 'accent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
