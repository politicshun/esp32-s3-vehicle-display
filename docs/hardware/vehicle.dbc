 SG_ Temp : 16|8@1+ (1,-20) [-20|235] "degC"  CLUSTER
 SG_ DClinkVoltage : 8|8@1+ (1,0) [0|80] "V"  CLUSTER
 SG_ SOC : 0|8@1+ (1,0) [0|100] "%"  CLUSTER

BO_ 256 InvMsg1: 8 INVERTER
