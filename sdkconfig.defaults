# sdkconfig.defaults
# idf.py set-target 또는 sdkconfig가 없을 때 자동 적용되는 기본값.
# 여기 있는 항목은 전부 이 프로젝트 대화 기록/실제 sdkconfig(idf.py save-defconfig 기준)에서
# 확인된 값만 넣었습니다.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Bluetooth / NimBLE (BLE GATT 서버 구현 시 확정) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# --- BLE Just Works bonding (2026-08-03, 사용자 확인) ---
# NVS_PERSIST: 페어링 키를 NVS에 저장해서 재부팅 후에도 재연결 시 재페어링 불필요하게 함
#   (main/main.c에서 ble_init() 전에 nvs_flash_init() 호출 필요 — 실제로 추가함).
# HANDLE_REPEAT_PAIRING_DELETION: 폰이 기존 본딩을 잃어버리고 재페어링을 시도하는 경우
#   (앱 재설치, 블루투스 설정 초기화 등) 스택이 자동으로 기존 키 삭제 후 재페어링을 진행하게 함
#   — 꺼두면 BLE_GAP_EVENT_REPEAT_PAIRING을 앱이 직접 처리해야 하는데 아직 그 핸들러가 없음.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y

# --- Flash size (ESP32-S3-WROOM-1-N8R8, 8MB Flash) ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# --- Partition table: 8MB 플래시 중 기본 partitions_singleapp.csv는 factory에 1M만
#     할당해서 UI 이미지 에셋 추가만으로 여유가 17%까지 떨어짐(2026-07-30, docs/design/ui-layout.md).
#     factory를 4M로 늘린 커스텀 테이블(partitions.csv)로 교체 — 8MB 중 nvs+phy_init+factory
#     합쳐도 4.03MB만 써서 향후 에셋 작업 여유를 크게 확보한다. ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- PSRAM (ESP32-S3-WROOM-1-N8R8의 R8 = Octal 임베디드 PSRAM 8MB) ---
# 실기기 부팅 로그(esptool)에서 "Embedded PSRAM 8MB (AP_3v3)"로 실측 확인(2026-07-30).
# 옵션명은 IDF v6.0.2 설치 경로의 esp_psram/esp32s3/Kconfig.spiram 및
# examples/peripherals/lcd/rgb_panel/sdkconfig.defaults.esp32s3(동일 RGB+PSRAM 프레임버퍼 구성)로 대조함.
# 이게 없으면 esp_lcd_new_rgb_panel()의 fb_in_psram=true가 "no mem for frame buffer"로 실패함.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Legacy driver / deprecation 경고 억제 (idf.py save-defconfig로 확인, 2026-07-29) ---
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# --- LVGL 폰트: main/ui/ui_style.c가 lv_font_montserrat_24/48을 참조함.
#     idf.py save-defconfig가 이 두 항목은 자동으로 못 뽑아내서(defaults 파일에 없던 심볼은
#     현재 sdkconfig 값을 기본값으로 취급해버려 diff가 0이 되는 kconfgen 함정) 수동으로 추가함
#     (2026-07-29). ---
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# --- LVGL 리프레시/입력 폴링 주기: lvgl_ui_task의 20ms 루프 주기와 맞춤(2026-07-30).
#     기본값 30ms에서는 20ms마다 도는 태스크 루프 중 일부가 lv_timer_handler() 안에서
#     "아직 주기 안 지남"으로 버려져 드래그 반응이 뻑뻑하게 느껴짐.
#     (2026-08-04: direct_mode 실험 중 물리 프레임 주기와의 경합 가능성 때문에 잠깐
#     30ms로 올려봤으나 지직거림과는 무관한 것으로 판명되어 direct_mode를 되돌리며
#     같이 원복함.) ---
CONFIG_LV_DISP_DEF_REFR_PERIOD=20
CONFIG_LV_INDEV_DEF_READ_PERIOD=20

# --- LVGL 내부 오브젝트 메모리 풀: 기본 32KB로는 Voltline 5탭 UI(위젯 수가 이전
#     4탭/단일페이지보다 훨씬 많음)를 다 못 담는다 — 2026-09-03 실기기 디버깅으로
#     확정: task watchdog(IDLE1 미응답, lv_obj_create 안에서 영구 정지)의 정체는
#     LVGL 내부 힙 고갈이었다. `LV_USE_ASSERT_MALLOC=y`라 malloc 실패 시 LVGL이
#     크래시/로그 없이 `while(1)`(디스어셈블리로 `j .` 자기자신 무한점프 직접 확인)로
#     조용히 멈춘다 — watchdog 로그의 백트레이스가 매번 완전히 똑같았던 이유.
#
#     **미해결 — 다음 세션 첫 판단 사항.** 시도한 완화책과 실기기 실측 결과 전부
#     project_2026-09-02_voltline_5tile_ui_rewrite.md 메모리에 상세 기록:
#     (1) lvgl_ui 태스크 스택을 PSRAM으로 이전(main.c) — 안전, 유지 중.
#     (2) 이 값(LV_MEM_SIZE_KILOBYTES)을 32->40KB로 증설 — largest_free_block 여유
#     1024 bytes로 드로우 버퍼(76800B)는 겨우 들어가지만, 5탭 다는 못 담아서 Setup
#     탭 lv_slider_create()에서 LoadProhibited 크래시+재부팅 루프(다른 형태의 같은
#     OOM). 48/96KB는 largest_free_block이 불균형하게 더 크게 깎여서(예: 16KB
#     늘렸는데 18KB+ 깎임) 드로우 버퍼 자체가 할당 실패.
#     (3) LV_MEM_CUSTOM으로 LVGL 힙 전체를 PSRAM 이전 — hang/크래시는 사라지지만
#     프레임당 200ms(예산 20ms의 10배, 2026-08-05 PSRAM 렌더 버그 재현) — 출하 불가.
#     지금은 (2)의 40KB로 둔 상태(hang은 없지만 Setup 탭에서 크래시 루프 — 미해결
#     방치). 다음 세션에서 위젯 개수 감축 / 드로우 버퍼 축소(테어링 트레이드오프) /
#     PSRAM 힙+렌더 최적화 중 하나를 사용자와 정하고 진행할 것. ---
#
# 2026-09-03(2차): 사용자 결정 — 드로우 버퍼 축소(main/lvgl.c LVGL_DRAW_BUF_LINES
# 48->40, 76800B->64000B)로 largest_free_block 여유를 만들고, 그 여유를 여기에 씀.
# 48KB 실기기 검증: largest_free_block=69632B(예측 정확히 일치) > 64000B라 드로우
# 버퍼 할당은 성공. 하지만 5탭 위젯 생성은 전부 통과하고 그다음 푸터
# (ui_chrome_build_footer)에서 LVGL 자체 힙 고갈로 크래시 — 마지막 조각만 부족.
#
# 2026-09-03(3차): 48->52KB(+4KB)로 재시도, largest_free_block=65536B(요청 64000B,
# 여유 1536B)로 크래시는 해결됐으나 여유가 너무 취약 + 실기기에서 테어링 재발 리포트.
#
# 2026-09-03(4차) 근본 해결: Trip 탭 제거(main/ui/ui.c, ui_chrome.h 참고, 5탭 중
# 위젯 밀도 최다 탭)로 LVGL 힙 사용량 자체를 줄이고, 드로우 버퍼도 48라인(76800B)
# 으로 복귀(main/lvgl.c). 40KB는 이미 largest_free_block=77824B(76800B 요구량 대비
# 여유 1024B)로 실측된 값이라 드로우 버퍼 할당은 될 것으로 예상 — Trip 탭이 빠진
# 만큼 LVGL 자체 힙(40KB) 안에서 4탭이 다 지어지는지가 이번 실기기 검증 포인트.
#
# 2026-09-04(5차): 4탭으로 줄었는데도 여유 1024B가 다시 문제가 됐다 — Voltline UI에
# CAN 신호 9개를 새로 배선(위젯 자체는 안 늘렸는데도, 텔테일/온도 라벨 갱신 빈도가
# 늘면서 LVGL 내부 힙 파편화가 심해진 것으로 추정) 후 task watchdog(2026-09-03과
# 완전히 동일한 시그니처 — lv_mem_buf_get() 안에서 while(1), 백트레이스 100% 재현)이
# 다시 발생, 게다가 이번엔 부팅 직후 거의 바로 걸림(이전보다 심함). 위젯 3개를
# 줄여봤지만 여유가 안 생겨서(9/3(2차)가 이미 확인한 값 그대로) 근본적으로
# 40KB로는 이 UI를 못 담는다고 결론 — 9/3(2차)에서 이미 검증된 조합(48KB 힙 +
# 드로우버퍼 40라인, largest_free_block=69632B > 64000B 요구량, 드로우버퍼 할당
# 자체는 확실히 성공)으로 올린다. 그때는 5탭이라 힙이 부족했지만 지금은 4탭이라
# 여유가 있을 것으로 예상 — `lv_mem_monitor()` 진단(main/lvgl.c, 임시)으로 실측
# 재확인할 것.
CONFIG_LV_MEM_SIZE_KILOBYTES=48
