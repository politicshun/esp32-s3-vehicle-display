# ESP-IDF build output (재생성 가능)
build/

# ESP-IDF 컴포넌트 매니저가 idf_component.yml로부터 재다운로드하는 의존성
managed_components/

# menuconfig가 남기는 이전 sdkconfig 백업
sdkconfig.old

# 에디터/OS 잡파일
.vscode/
*.swp
Thumbs.db

# scripts/ 파이썬 도구 실행 시 생기는 바이트코드 캐시 (재생성 가능)
scripts/__pycache__/
__pycache__/

# Claude Code 로컬 전용 설정 (개인별 권한 오버라이드, 공유 대상 아님)
.claude/settings.local.json

# CAN 정리표 초안(xlsx) — 사용자 확인: 깃허브에 릴리즈할 필요 없음, 로컬 작업본으로만 유지 (2026-07-31)
docs/hardware/CLUSTER_CAN_Protocol_*.xlsx
docs/hardware/~$*.xlsx
